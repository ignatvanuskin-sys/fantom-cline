# ==========================================
# Telegram-уведомления о заявках
# Скопируйте этот файл как .env.local и впишите свои значения.
# Подробная инструкция — в README, раздел 3.
# ==========================================

# Токен бота от @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=

# id чата/группы, куда приходят заявки.
# Узнать: https://api.telegram.org/bot<ТОКЕН>/getUpdates → "chat":{"id": ...}
# Для группы значение отрицательное, напр. -1001234567890
TELEGRAM_CHAT_ID=
